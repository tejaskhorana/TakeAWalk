// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in locally.
// Never commit the real file or the .p8 key it refers to.

WEATHERKIT_TEAM_ID = YOUR_APPLE_TEAM_ID
WEATHERKIT_SERVICE_ID = com.yourname.WeatherIdeal
WEATHERKIT_KEY_ID = YOUR_KEY_ID
// Path to the .p8 private key kept OUTSIDE this repo, e.g. ~/.config/weatherideal/AuthKey.p8
WEATHERKIT_PRIVATE_KEY_PATH = ~/.config/weatherideal/AuthKey.p8
